# godot-mcp: headless Godot engine behind a minimal MCP streamable-HTTP server.
FROM docker.io/barichello/godot-ci:4.3
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir fastapi uvicorn
WORKDIR /app
COPY mcp_http.py godot_mcp.py /app/
ENV GODOT_BIN=godot
EXPOSE 8090
CMD ["uvicorn", "godot_mcp:app", "--host", "0.0.0.0", "--port", "8090"]
