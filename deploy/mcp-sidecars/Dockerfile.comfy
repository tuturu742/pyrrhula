# comfy-mcp: bridge to a ComfyUI instance behind a minimal MCP streamable-HTTP server.
FROM python:3.12-slim
RUN pip install --no-cache-dir fastapi uvicorn httpx pillow
WORKDIR /app
COPY mcp_http.py comfy_mcp.py /app/
VOLUME /assets
EXPOSE 8091
CMD ["uvicorn", "comfy_mcp:app", "--host", "0.0.0.0", "--port", "8091"]
