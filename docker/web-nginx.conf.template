# A WebSocket needs `Connection: upgrade` forwarded, and the api block below deliberately
# sends `Connection: ""` to keep upstream connections alive. This map keeps both: a request
# carrying an Upgrade header gets `upgrade`, and every ordinary request gets the empty value
# it got before. Without it a preview can serve a page but never a socket, which is the
# whole of what ttyd (terminal) and noVNC (desktop) need.
map $http_upgrade $pyr_connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Same contract as the Vite dev proxy: /api/<path> -> api container /<path>
    # (trailing slash on proxy_pass strips the matched prefix). Buffering must stay off:
    # the session SSE stream and the assistant chat's NDJSON both rely on chunks
    # reaching the browser as they are produced. The upstream host:port comes from
    # PYRRHULA_API_UPSTREAM (nginx image envsubst on templates/) so remote deployments
    # (ECS service discovery, k8s Services) can point it anywhere.
    location ~ ^/api/(.*)$ {
        # The upstream is held in a VARIABLE deliberately. nginx re-resolves a variable
        # upstream per request (honouring the resolver written by web-resolver.sh), while
        # a literal hostname here is resolved once at startup and cached for the life of
        # the process -- so a redeployed api Service leaves this proxying at a dead
        # address until someone restarts the container. The captured $1 reproduces what
        # the old trailing slash did: /api/<path> -> <path>.
        set $api_upstream "${PYRRHULA_API_UPSTREAM}";
        proxy_pass http://$api_upstream/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pyr_connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        client_max_body_size 50m;
    }

    # Hashed asset filenames change on every build, so they can be cached hard...
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ...but index.html names those files, so a cached copy of it pins the browser to a
    # bundle that no longer exists on the server. Revalidate it every time: without this
    # a UI change can ship and simply not appear until someone hard-reloads.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA: every non-file route renders index.html (client-side router).
    location / {
        try_files $uri /index.html;
    }
}
