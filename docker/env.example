# Copy to the repo root as `.env` and fill in every required value.
#   cp docker/env.example .env
# Generate secrets:
#   openssl rand -base64 48   # JWT secret
#   openssl rand -base64 32   # encryption key (must decode to exactly 32 bytes)
#   openssl rand -hex 24      # passwords/tokens

# --- required ---------------------------------------------------------------
PYRRHULA_POSTGRES_PASSWORD=
PYRRHULA_APP_DB_PASSWORD=
PYRRHULA_JWT_SECRET=
PYRRHULA_ADMIN_TOKEN=
PYRRHULA_ENCRYPTION_KEY=

# The platform admin, created idempotently on first boot -- BOTH must be set or no such
# account exists and there is no way to sign in as one (the installer generates these for
# you; this manual path does not). Sign in with organization "admin".
PYRRHULA_ADMIN_EMAIL=admin@pyrrhula.app
PYRRHULA_ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------
# The base of preview share links as a browser sees them. Defaults to the API's own
# address, which is wrong the moment a tester opens the link from another machine.
#PYRRHULA_PUBLIC_BASE_URL=http://localhost:5173
# Host ports:
#PYRRHULA_WEB_PORT=5173
#PYRRHULA_API_PORT=8000
#PYRRHULA_ADMIN_PORT=8100

# Engine socket on the host (docker hosts: /var/run/docker.sock):
#PYRRHULA_ENGINE_SOCKET=/run/user/1000/podman/podman.sock

# SearXNG-compatible endpoint for the per-persona web-search switch:
#PYRRHULA_WEB_SEARCH_URL=

# Retrieval models load strictly from the shared cache; the runtime never reaches
# Hugging Face on its own (an admin-console download lifts this for that fetch alone).
# Set to 0 only if you want the old lazy in-request fetch back -- it can stall a turn
# for minutes and has wedged the API's event loop.
#PYRRHULA_HF_OFFLINE=1

# Remote exec engines (k8s/cloud) need a routable git base:
#PYRRHULA_GIT_HTTP_BASE=https://your-host/api
