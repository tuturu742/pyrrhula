# TLS variant of web-nginx.conf.template, selected by PYRRHULA_TLS (docker/web-tls.sh).
# Certificates are never baked: bring your own (Let's Encrypt via certbot/lego on the
# host, a corporate CA) at /etc/nginx/certs/{fullchain.pem,privkey.pem}, or let
# PYRRHULA_TLS=self-signed generate a pair there on first start.
#
# Plain http exists only to redirect -- a login form served over http is a login form
# whose password is on the wire.
# BEGIN plain-http redirect (dropped when PYRRHULA_TLS_LISTEN=80: one port, https only)
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}
# END plain-http redirect

server {
    listen 443 ssl;
    http2 on;
    server_name ${PYRRHULA_TLS_SERVER_NAME};

    # Plain http sent to this port (a bookmark, a typed address) is answered with a
    # redirect to the same host and port over https, instead of nginx's "400 The plain
    # HTTP request was sent to HTTPS port". $http_host keeps the port the client used,
    # which matters when 443 is published somewhere else (5173 on a Portainer host).
    error_page 497 =301 https://$http_host$request_uri;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS: once a browser has seen this deployment over https it must never fall back.
    # Start with a short max-age while validating the certificate chain, then raise it.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root /usr/share/nginx/html;
    index index.html;

    # The retrieval-model cache archive (Admin -> Models -> Upload cache archive) is
    # gigabytes -- bge-m3 plus its reranker is ~4GB -- so it cannot share the 50m
    # ceiling below: the upload died at nginx with a 413 before the api, whose own limit
    # is 12GiB, ever saw it. Streamed straight through rather than spooled to the web
    # container's disk first. An exact match wins over the regex location below.
    location = /api/admin/retrieval-models/upload {
        set $api_upstream "${PYRRHULA_API_UPSTREAM}";
        proxy_pass http://$api_upstream/admin/retrieval-models/upload$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 12g;
    }

    # Identical proxy contract to the plain-http template: buffering OFF so the session
    # SSE stream and the assistant's NDJSON reach the browser as they are produced.
    location ~ ^/api/(.*)$ {
        # Variable upstream, same reason as the plain-http template: nginx resolves a
        # literal proxy_pass hostname once at startup and never again, so a redeployed
        # api leaves this proxying at a dead address. $1 reproduces the old trailing
        # slash's prefix stripping. Needs the resolver from web-resolver.sh.
        set $api_upstream "${PYRRHULA_API_UPSTREAM}";
        proxy_pass http://$api_upstream/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        client_max_body_size 50m;
    }

    # Hashed asset filenames change on every build, so they can be cached hard...
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ...but index.html names those files, so a cached copy of it pins the browser to a
    # bundle that no longer exists on the server. Revalidate it every time.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri /index.html;
    }
}
